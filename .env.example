# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Database (MongoDB)
# ===========================================
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/saree-shop?retryWrites=true&w=majority"

# ===========================================
# Frontend URL (for CORS)
# ===========================================
FRONTEND_URL="http://localhost:3000"

# ===========================================
# Clerk Authentication
# Get these from: https://dashboard.clerk.com
# ===========================================
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ===========================================
# Stripe Payments (Optional)
# Get these from: https://dashboard.stripe.com
# ===========================================
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ===========================================
# Razorpay Payments (Optional)
# Get these from: https://dashboard.razorpay.com
# ===========================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxx"

# ===========================================
# Cloudinary (Image Uploads)
# Get these from: https://cloudinary.com/console
# ===========================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
