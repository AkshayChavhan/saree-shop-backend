# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Master API Key Authentication
# ===========================================
# Master API key required for all API requests
# Include this in the X-API-Key header for all backend calls
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_API_KEY=your-secure-master-api-key-here-change-in-production

# Set to 'true' to bypass master key check in development (NOT recommended for production)
BYPASS_MASTER_KEY=false

# ===========================================
# Database (MongoDB)
# ===========================================
# Get your MongoDB connection string from MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/saakie?retryWrites=true&w=majority

# ===========================================
# Frontend URL (for CORS)
# ===========================================
# URL of your frontend application
FRONTEND_URL=http://localhost:3000

# ===========================================
# Clerk Authentication
# ===========================================
# Get these from: https://dashboard.clerk.com
# Navigate to: API Keys section
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# ===========================================
# Stripe Payments (Optional)
# ===========================================
# Get these from: https://dashboard.stripe.com/test/apikeys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ===========================================
# Razorpay Payments (Optional)
# ===========================================
# Get these from: https://dashboard.razorpay.com/app/keys
# Use test mode keys for development
RAZORPAY_KEY_ID=rzp_test_your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ===========================================
# Cloudinary (Image Uploads)
# ===========================================
# Get these from: https://cloudinary.com/console
# Navigate to: Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# IMPORTANT NOTES
# ===========================================
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env to git (it's in .gitignore)
# 3. Always commit .env.example with placeholder values
# 4. Generate secure keys for production using crypto.randomBytes()
# 5. Use different keys for development, staging, and production
